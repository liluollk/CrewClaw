# 复制为 .env 并填入真实配置（.env 已被 gitignore，不会提交）
# 模型接入：任意 OpenAI 兼容接口（也可在 Web 设置页配置，或使用订阅套餐登录）
MINICLAW_BASE_URL=https://your-openai-compatible-endpoint/v1
MINICLAW_API_KEY=你的_API_KEY
MINICLAW_MODEL=你的模型名
PORT=3000

# ── 渠道网关（配置凭据后启动时自动常驻连接） ──────────────────────
# 飞书：开放平台建应用 → 事件订阅选「长连接」→ 填下面两项
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# 钉钉：企业内部机器人 → Stream 模式凭据
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=
# 群聊必须 @机器人才响应（默认开；置 0 关闭）
# GROUP_REQUIRE_MENTION=0

# ── 多用户 ────────────────────────────────────────────────────────────
# 会话签名密钥（≥16 字符；不配则自动生成 data/web-session-secret）
# WEB_SESSION_SECRET=
# 渠道凭据加密密钥（≥16 字符；不配则从会话密钥派生）
# CHANNEL_ENCRYPTION_KEY=
# 注册开关（默认开放；置 0 关闭注册，仅登录）
# ALLOW_REGISTER=0
